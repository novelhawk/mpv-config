//!HOOK MAIN
//!BIND HOOKED
//!DESC Sioyek custom color dark mode

vec4 hook() {
    vec4 c = HOOKED_tex(HOOKED_pos);

    // Sioyek transformation matrix in column-major order: mat4(col0, col1, col2, col3)
    // Derived from Sioyek default colors:
    // bg   = (0.180, 0.204, 0.251)
    // text = (0.847, 0.871, 0.914)
    // k    = 0.8 * (1.0 - 0.204) = 0.6368
    const mat4 transform = mat4(
        vec4( 0.1530, -0.2342, -0.9140, 0.0), // Column 0 (weights for R)
        vec4( 0.0270, -0.1986,  0.1650, 0.0), // Column 1 (weights for G)
        vec4(-0.8470, -0.2342,  0.0860, 0.0), // Column 2 (weights for B)
        vec4( 0.8470,  0.8710,  0.9140, 1.0)  // Column 3 (offsets / black point)
    );

    vec3 result = (transform * vec4(c.rgb, 1.0)).rgb;

    return vec4(clamp(result, 0.0, 1.0), c.a);
}
