//!HOOK MAIN
//!BIND HOOKED
//!DESC Dark mode luminance inverter

vec4 hook() {
    vec4 c = HOOKED_tex(HOOKED_pos);
    
    // Calculate perceived luminance
    float luma = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));
    
    // Invert lightness while keeping chrominance ratio
    float new_luma = 1.0 - luma;
    vec3 out_col = c.rgb * (new_luma / max(luma, 0.0001));
    
    return vec4(clamp(out_col, 0.0, 1.0), c.a);
}
